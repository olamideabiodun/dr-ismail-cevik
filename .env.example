# =============================================================================
# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import into a Client
# Component — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------------
# Absolute origin, no trailing slash. Used to build cancel/reschedule links in
# the confirmation email and to resolve Open Graph URLs.
# Local: http://localhost:3000   Production: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) -----------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=

# Where the internal copy of every booking is sent (the clinic's own inbox).
NOTIFY_EMAIL=

# The From: address on patient confirmations. Must be a verified Resend domain.
# Falls back to Resend's onboarding@resend.dev sandbox sender when unset, which
# can ONLY deliver to the address that owns the Resend account.
BOOKING_FROM_EMAIL="Op. Dr. İsmail Çevik <randevu@example.com>"
